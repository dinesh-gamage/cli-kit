{
  "name": "@dinesh-gamage/cli-kit",
  "version": "0.1.0",
  "description": "Zero-dependency toolkit for friendly CLIs: colors, tables, spinners, progress bars, prompts, and logging with graceful non-TTY fallbacks",
  "license": "MIT",
  "author": "Dinesh Gamage",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --target node18 --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "tsx examples/demo.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
